# InkPro — Azure App Service production settings.
# Set these as App Service > Configuration > Application settings (NOT a file).

# --- Core -------------------------------------------------------------------
DEBUG=False
# Generate with: python manage.py generate_secret_key
SECRET_KEY=e*ntn-#@!5e_-*5x%%9u!i&4=#n00+ah_rgn1kkor-)@zil_+=
ALLOWED_HOSTS=inkprosamoa.com,www.inkprosamoa.com,<your-app>.azurewebsites.net
CSRF_TRUSTED_ORIGINS=https://inkprosamoa.com,https://www.inkprosamoa.com
SITE_URL=https://inkprosamoa.com

# --- Database (Azure Database for PostgreSQL, flexible server) --------------
# SSL is mandatory; sslmode=require is also applied automatically.
DATABASE_URL=postgres://USER:PASSWORD@YOURSERVER.postgres.database.azure.com:5432/inkpro?sslmode=require

# --- Persistent media -------------------------------------------------------
# Only /home survives restarts, and /home/site/wwwroot is replaced on deploy.
MEDIA_ROOT=/home/site/media

# --- Email ------------------------------------------------------------------
# Without this, quotes are printed to the log instead of being sent.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.yourprovider.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=InkPro <quotes@inkprosamoa.com>
STAFF_NOTIFY_EMAILS=quotes@inkprosamoa.com

# --- Business ---------------------------------------------------------------
GST_RATE=0.15
QUOTE_VALID_DAYS=30
CURRENCY_CODE=WST
CURRENCY_NAME=Samoan Tala
LAUNCH_PROMO_ENABLED=True

# --- App Service platform settings (set these too) --------------------------
# WEBSITES_ENABLE_APP_SERVICE_STORAGE=true   # keeps /home persistent
# SCM_DO_BUILD_DURING_DEPLOYMENT=true        # lets Oryx install requirements.txt
