# Copy to .env and fill in. Anything omitted falls back to a dev-safe default.

# --- Core ---------------------------------------------------------------
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://inkpro.example
SITE_URL=http://localhost:8000

# --- Database -----------------------------------------------------------
# Leave unset for SQLite. For PostgreSQL:
# DATABASE_URL=postgres://inkpro:inkpro@localhost:5432/inkpro

# --- Email --------------------------------------------------------------
# Console backend prints emails to the terminal — good for development.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For real sending, switch to SMTP and fill in the rest:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.yourprovider.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=InkPro <quotes@inkpro.example>
STAFF_NOTIFY_EMAILS=quotes@inkpro.example

# --- Microsoft 365 email (Microsoft Graph + OAuth) ----------------------
# The office mailbox is on Microsoft 365, where basic SMTP auth is switched
# off, so we authenticate as an Azure AD app instead of using a password.
# In the Azure portal: Entra ID > App registrations > New registration, then
# add the Microsoft Graph *application* permission Mail.Send and grant admin
# consent. Details in main/graph_mail.py.
#
# EMAIL_BACKEND=main.graph_mail.GraphEmailBackend
# MS_GRAPH_TENANT_ID=            # Directory (tenant) ID
# MS_GRAPH_CLIENT_ID=            # Application (client) ID
# MS_GRAPH_CLIENT_SECRET=        # the secret VALUE, not the secret ID
# MS_GRAPH_SENDER=sales@inkpro.example   # mailbox to send from
# MS_GRAPH_SAVE_TO_SENT_ITEMS=True  # keep a copy in that mailbox's Sent Items
#
# Then verify before going live:  python manage.py graphcheck --to you@inkpro.example

# Optional Slack ping on new quote requests and acceptances.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# --- Async --------------------------------------------------------------
# Leave blank to run email and PDF work inline (no worker needed).
# CELERY_BROKER_URL=redis://localhost:6379/0

# --- Business rules -----------------------------------------------------
GST_RATE=0.15
QUOTE_VALID_DAYS=30

# Prices are quoted in Samoan Tala.
CURRENCY_CODE=WST
CURRENCY_NAME=Samoan Tala

# Scroll-driven WebGL layer on the homepage. Currently off.
ENABLE_3D_HERO=False

# Launch promotion marquee in the hero. Set to False to retire the offer.
LAUNCH_PROMO_ENABLED=True
LAUNCH_PROMO_TEXT=We just launched — our first 20 sales will receive a massive 50% discount
